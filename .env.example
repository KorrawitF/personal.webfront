# Template for local env config. Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Load order (first hit wins): process.env -> .env.$NODE_ENV.local -> .env.local -> .env.$NODE_ENV -> .env
# .env.local is gitignored; this file is committed and must never hold real secrets.
#
# Every variable below is optional: app/global/config/site.ts falls back to the
# site's real values, so a fresh clone builds without any .env file. That module is
# the only place the app reads process.env — import the value from it rather than
# adding a new read.

# --- Ports -------------------------------------------------------------------
# Read by scripts/with-env.mjs, which loads these files and passes the port to the
# CLI. The HTTP server boots before app code, so Next cannot pick PORT up on its own.
PORT=3000
STORYBOOK_PORT=6006

# --- Exposed to the browser --------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle at `next build` time and is
# frozen at that value — treat it as public, and never put a secret here.
# All of the following are read by app/global/config/site.ts, the app's only
# process.env reader.

# Identity. NEXT_PUBLIC_SITE_NAME defaults to the first word of the owner name,
# NEXT_PUBLIC_SITE_BRAND to that name with a full stop, and the title template to
# "<name> • %s", where Next fills %s with the page title.
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_BRAND=
NEXT_PUBLIC_SITE_TITLE_TEMPLATE=
# Absolute origin the site is served from; relative metadata URLs resolve against it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# BCP 47 tag for the lang attribute on <html>.
NEXT_PUBLIC_SITE_LOCALE=en

# The longest message the contact form accepts. The résumé file and every contact
# channel are content the backend serves, so neither is configured here.
NEXT_PUBLIC_RESUME_MESSAGE_MAX_LENGTH=1000
