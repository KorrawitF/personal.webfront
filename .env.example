# Template for local env config. Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Load order (first hit wins): process.env -> .env.$NODE_ENV.local -> .env.local -> .env.$NODE_ENV -> .env
# .env.local is gitignored; this file is committed and must never hold real secrets.
#
# Every variable below is optional: app/global/config/site.ts falls back to the
# site's real values, so a fresh clone builds without any .env file. site.ts and
# api.ts are the only places the app reads process.env — import the value from
# one of them rather than adding a new read.

# --- Ports -------------------------------------------------------------------
# Read by scripts/with-env.mjs, which loads these files and passes the port to the
# CLI. The HTTP server boots before app code, so Next cannot pick PORT up on its own.
PORT=3000
STORYBOOK_PORT=6006

# --- Backend -------------------------------------------------------------------
# Read by app/global/config/api.ts. Every call in app/global/lib/api.ts runs
# server-side, so this is deliberately not NEXT_PUBLIC_* and never reaches the
# client bundle.
API_URL=http://localhost:8080/api

# --- Site identity -------------------------------------------------------------
# Read by app/global/config/site.ts. Every call runs server-side and passes the
# resolved values down as props, so deliberately not NEXT_PUBLIC_* — a built
# Docker image can be reconfigured per environment with plain runtime env vars,
# rather than needing a rebuild.

# Identity. SITE_NAME defaults to the first word of the owner name, SITE_BRAND
# to that name with a full stop, and the title template to "<name> • %s", where
# Next fills %s with the page title.
OWNER_NAME=
SITE_NAME=
SITE_BRAND=
SITE_TITLE_TEMPLATE=
# Absolute origin the site is served from; relative metadata URLs resolve against it.
SITE_URL=http://localhost:3000
# BCP 47 tag for the lang attribute on <html>.
SITE_LOCALE=en

# --- Analytics -----------------------------------------------------------------
# Read by app/global/config/site.ts. Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Optional: leave blank and no analytics code and no consent banner is rendered.
# Nothing is loaded from Google until a visitor accepts the banner. Read per
# request on the server, so it can be changed without rebuilding the image.
GA_MEASUREMENT_ID=
